{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "uv: sync",
      "type": "process",
      "command": "uv",
      "args": [
        "sync",
        "--locked"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Signal Lab: run server",
      "type": "process",
      "command": "uv",
      "args": [
        "run",
        "--locked",
        "python",
        "server.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Signal Lab: download S&P 500 hourly data",
      "type": "process",
      "command": "uv",
      "args": [
        "run",
        "--locked",
        "python",
        "download_sp500.py",
        "--resolution",
        "hourly"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Signal Lab: download NVDA daily data",
      "type": "process",
      "command": "uv",
      "args": [
        "run",
        "--locked",
        "python",
        "download_data.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Python: run tests",
      "type": "process",
      "command": "uv",
      "args": [
        "run",
        "--locked",
        "python",
        "-m",
        "unittest",
        "discover",
        "-s",
        "tests",
        "-v"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Jupyter: notebook",
      "type": "process",
      "command": "uv",
      "args": [
        "run",
        "--locked",
        "jupyter",
        "notebook"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
